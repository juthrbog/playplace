# Generated for a tagged release. Review before submitting to the AUR.
pkgname=playplace
pkgver={{ .PackageVersion }}
pkgrel=1
pkgdesc='Short-lived AWS playground accounts with guardrails'
arch=('x86_64' 'aarch64')
url='https://github.com/juthrbog/playplace'
license=('Apache-2.0')
makedepends=('go>=2:1.27.2')
_release_version='{{ .Version }}'
source=("playplace-${_release_version}.tar.gz::${url}/releases/download/{{ .Tag }}/playplace_${_release_version}_source.tar.gz")
sha256sums=('{{ index .Checksums "source" }}')

build() {
  cd "playplace-${_release_version}"
  export CGO_ENABLED=0
  go build -trimpath -mod=readonly -buildmode=pie \
    -ldflags="-s -w -X playplace/internal/cli.version=${_release_version}" \
    -o playplace ./cmd/playplace
  ./playplace completion bash > playplace.bash
  ./playplace completion zsh > _playplace
  ./playplace completion fish > playplace.fish
}

check() {
  cd "playplace-${_release_version}"
  go test ./...
  ./playplace --version
}

package() {
  cd "playplace-${_release_version}"
  install -Dm755 playplace "${pkgdir}/usr/bin/playplace"
  install -Dm644 playplace.bash "${pkgdir}/usr/share/bash-completion/completions/playplace"
  install -Dm644 _playplace "${pkgdir}/usr/share/zsh/site-functions/_playplace"
  install -Dm644 playplace.fish "${pkgdir}/usr/share/fish/vendor_completions.d/playplace.fish"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/playplace/LICENSE"
  # The same docs as the release archive in .goreleaser.yaml.
  install -Dm644 README.md "${pkgdir}/usr/share/doc/playplace/README.md"
  install -Dm644 -t "${pkgdir}/usr/share/doc/playplace/docs" \
    docs/{index,requesting,approving,cli,configuration,budgets,deploy}.md
  install -Dm644 -t "${pkgdir}/usr/share/doc/playplace/docs/assets" docs/assets/banner.png
  install -Dm644 -t "${pkgdir}/usr/share/doc/playplace/deploy" deploy/README.md
  install -Dm644 -t "${pkgdir}/usr/share/doc/playplace/deploy/aws" deploy/aws/*.json
}
