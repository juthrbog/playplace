package web

import (
	"fmt"
	"strconv"
	"strings"
	"time"

	"playplace/internal/core"
)

// layout is the frame of every page. The htmx config turns off eval and the
// indicator style element that htmx adds to the head, because the CSP blocks
// both.
templ layout(pg page, title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · playplace</title>
			<link rel="icon" href={ asset("favicon.svg") } type="image/svg+xml"/>
			<link rel="icon" href={ asset("favicon.ico") } sizes="32x32"/>
			<link rel="apple-touch-icon" href={ asset("apple-touch-icon.png") }/>
			<link rel="stylesheet" href={ asset("app.css") }/>
			<meta name="htmx-config" content='{"allowEval":false,"selfRequestsOnly":true,"includeIndicatorStyles":false}'/>
			<script src={ asset("htmx.min.js") }></script>
			<script src={ asset("app.js") }></script>
		</head>
		<body>
			@iconSprite()
			@shell(pg)
			if !pg.SignIn {
				<div class="noauth" role="note">@icon("alert")<span>Sign-in is off. Every visitor is an admin.</span></div>
			}
			<main>
				<p id="notice" class="notice"></p>
				{ children... }
			</main>
		</body>
	</html>
}

// shell is the bar on every page. The links depend on the role: engineers
// get Home, approvers also get Queue with its count, and admins get Queue
// and Accounts, because the brand is their link home. The menu toggle comes
// right after the brand, so the next Tab after it enters the menu. On a phone
// the in-menu items hide behind it, and Queue and Sync stay in the bar.
templ shell(pg page) {
	<header class="shell">
		<a class="brand" href="/"><svg class="mark" aria-hidden="true" focusable="false"><use href="#i-mark"></use></svg><span class="brand-word"><b>play</b><span class="place">place</span></span></a>
		<button type="button" class="menu-toggle" aria-expanded="false" aria-controls="shell-menu">@icon("menu")<span class="vh">Menu</span></button>
		<div id="shell-menu" class="shell-menu">
			<nav class="nav" aria-label="Main">
				<ul>
					if !pg.Viewer.Admin {
						<li class="in-menu">
							<a
								class="nav-link"
								href="/"
								if pg.Path == "/" {
									aria-current="page"
								}
							>Home</a>
						</li>
					}
					if pg.Viewer.Approver {
						<li>
							<a class="nav-link" href="/#pending">
								Queue
								@queueCount(pg, false)
							</a>
						</li>
					}
					if pg.Viewer.Admin {
						<li class="in-menu"><a class="nav-link" href="/#accounts">Accounts</a></li>
					}
				</ul>
			</nav>
			if pg.Viewer.Admin {
				<form class="sync" hx-post="/refresh" hx-target="#accounts" hx-swap="outerHTML" hx-include="#show-closed">
					<button type="submit" class="btn-ghost" title="poll creations, sweep expiry, retry closes">@icon("sync")<span class="btn-word">Sync with AWS</span></button>
				</form>
			}
			<a class="btn btn-chip in-menu" href="/#request">
				@icon("plus")
				New request
			</a>
			if pg.SignIn {
				<span class="person in-menu">
					<span class="person-email">{ pg.Viewer.Email }</span>
					if pg.Viewer.Admin {
						<span class="badge">admin</span>
					}
				</span>
				<form class="signout in-menu" method="post" action="/auth/logout"><button type="submit" class="nav-link">Sign out</button></form>
			}
		</div>
	</header>
}

// queueCount is the number of pending requests beside Queue. It is empty at
// zero. The vh word tells a screen reader what the number counts.
templ queueCount(pg page, oob bool) {
	<span
		id="queue-count"
		if oob {
			hx-swap-oob="true"
		}
	>
		if len(pg.Pending) > 0 {
			<span class="count-pill">{ fmt.Sprint(len(pg.Pending)) }<span class="vh">{ " pending requests" }</span></span>
		}
	</span>
}

// pendingUpdate is the pending card for an htmx answer. Approvers also get
// the shell count, so the two never disagree. Other viewers have no Queue
// link. A count with no target makes htmx log an error.
templ pendingUpdate(pg page) {
	@pendingCard(pg)
	if pg.Viewer.Approver {
		@queueCount(pg, true)
	}
}

// icon draws one symbol of the sprite. It sits next to a word, so screen
// readers skip it.
templ icon(name string) {
	<svg class="i" aria-hidden="true" focusable="false"><use href={ "#i-" + name }></use></svg>
}

// iconSprite holds every icon and the mark as symbols on a 24 px grid. The
// symbols carry no fill or stroke: the .i and .mark rules in app.css set
// them, and <use> passes currentColor down.
templ iconSprite() {
	<svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
		<symbol id="i-mark" viewBox="0 0 24 24"><path d="M7.4 18.6h9.9a3.9 3.9 0 0 0 .4-7.8 5.6 5.6 0 0 0-10.7-1.1 4.5 4.5 0 0 0 .4 8.9z"></path><path d="M8.6 16.2c2.6 0 3.1-3.6 6.2-3.6"></path><circle cx="16" cy="15.6" r="1.1"></circle></symbol>
		<symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M8.6 12.3l2.4 2.4 4.5-5"></path></symbol>
		<symbol id="i-clock-arc" viewBox="0 0 24 24"><path d="M12 3.5a8.5 8.5 0 1 1-8.5 8.5"></path><path d="M12 8v4l2.5 1.5"></path></symbol>
		<symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path></symbol>
		<symbol id="i-hourglass" viewBox="0 0 24 24"><path d="M7 3.5h10M7 20.5h10M8 3.5v2.3a4 4 0 0 0 1.6 3.2L12 12l2.4-3a4 4 0 0 0 1.6-3.2V3.5M8 20.5v-2.3a4 4 0 0 1 1.6-3.2L12 12l2.4 3a4 4 0 0 1 1.6 3.2v2.3"></path></symbol>
		<symbol id="i-box" viewBox="0 0 24 24"><path d="M4 4.5h16v4H4zM5.5 8.5V19h13V8.5M12 11v5M9.5 13.5L12 16l2.5-2.5"></path></symbol>
		<symbol id="i-ban" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M6 6l12 12"></path></symbol>
		<symbol id="i-x-circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M9.2 9.2l5.6 5.6M14.8 9.2l-5.6 5.6"></path></symbol>
		<symbol id="i-minus" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M8 12h8"></path></symbol>
		<symbol id="i-dashed-circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" stroke-dasharray="2.4 3"></circle></symbol>
		<symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="1.5"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></symbol>
		<symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 4l9 16H3z"></path><path d="M12 10v4.2M12 17.2v.1"></path></symbol>
		<symbol id="i-sync" viewBox="0 0 24 24"><path d="M19.5 11a7.5 7.5 0 0 0-13.4-4.2L4.5 8.5M4.5 4v4.5H9M4.5 13a7.5 7.5 0 0 0 13.4 4.2l1.6-1.7M19.5 20v-4.5H15"></path></symbol>
		<symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></symbol>
		<symbol id="i-stamp" viewBox="0 0 24 24"><circle cx="12" cy="5.5" r="2.3"></circle><path d="M10.6 7.7V11M13.4 7.7V11"></path><rect x="4.5" y="11" width="15" height="4.5" rx="1"></rect><path d="M5 19.5h14"></path></symbol>
		<symbol id="i-unlock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="1.5"></rect><path d="M8 11V8a4 4 0 0 1 7.6-1.7"></path></symbol>
		<symbol id="i-slip" viewBox="0 0 24 24"><rect x="5.5" y="3.5" width="13" height="17" rx="1.5"></rect><path d="M8.5 8h7M8.5 11.5h7M8.5 15h4"></path></symbol>
		<symbol id="i-door" viewBox="0 0 24 24"><path d="M3.5 20.5h17M6.5 20.5v-16a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16"></path><path d="M14.5 12.5v.01"></path></symbol>
		<symbol id="i-bell" viewBox="0 0 24 24"><path d="M6.5 16.5V11a5.5 5.5 0 0 1 11 0v5.5l1.5 2h-14z"></path><path d="M10 21h4"></path></symbol>
		<symbol id="i-bell-off" viewBox="0 0 24 24"><path d="M6.5 16.5V11a5.5 5.5 0 0 1 11 0v5.5l1.5 2h-14z"></path><path d="M10 21h4"></path><path d="M4 4l16 16"></path></symbol>
		<symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"></path></symbol>
	</svg>
}

type accountRow struct {
	Account *core.Account
	Spend   float64 // month to date
}


// indexPage is the home page. The shell is the visible heading, so the page
// h1 is for screen readers only.
templ indexPage(pg page, rows []accountRow, errMsg string) {
	@layout(pg, "Accounts") {
		<h1 class="vh">Accounts</h1>
		<section class="panel" id="request" aria-labelledby="request-title">
			<div class="panel-head"><h2 id="request-title">New request</h2></div>
			<div class="panel-body">
				<form hx-post="/requests" hx-target="#accounts" hx-swap="outerHTML" hx-include="#show-closed" data-reset-on-success>
					<div class="form-row">
						<label class="field">name<input name="name" required pattern="[a-z0-9][a-z0-9\-]{1,48}[a-z0-9]" placeholder="dev-alex"/></label>
						if pg.Viewer.Admin {
							<label class="field">owner<input name="owner" placeholder="owner email" value={ ownerDefault(pg.Viewer) }/></label>
						} else {
							<label class="field">owner<input value={ pg.Viewer.Email } disabled title="requests are always in your name"/></label>
						}
						if pg.Viewer.Admin {
							<label class="field">days<input name="ttl" type="number" min="1" placeholder={ dayCount(pg.Limits.DefaultTTL) } title={ "up to " + dayCount(pg.Limits.MaxTTL) + " unless overridden" } class="in-days"/></label>
							<label class="field">budget $<input name="budget" type="number" min="1" placeholder={ fmt.Sprintf("%.0f", pg.Limits.DefaultBudgetUSD) } title={ fmt.Sprintf("up to $%.0f unless overridden", pg.Limits.MaxBudgetUSD) } class="in-budget"/></label>
						} else {
							<label class="field">days<input name="ttl" type="number" min="1" max={ dayCount(pg.Limits.MaxTTL) } placeholder={ dayCount(pg.Limits.DefaultTTL) } title={ "up to " + dayCount(pg.Limits.MaxTTL) } class="in-days"/></label>
							<label class="field">budget $<input name="budget" type="number" min="1" max={ fmt.Sprintf("%.0f", pg.Limits.MaxBudgetUSD) } placeholder={ fmt.Sprintf("%.0f", pg.Limits.DefaultBudgetUSD) } title={ fmt.Sprintf("up to $%.0f", pg.Limits.MaxBudgetUSD) } class="in-budget"/></label>
						}
						<label class="field">purpose<input name="purpose" placeholder="what you will try" size="24" maxlength={ fmt.Sprint(core.MaxPurpose) } pattern={ tagPattern } title="letters, numbers, spaces, and _ . : / = + - @"/></label>
						if pg.Viewer.Admin {
							<label class="check" title="admins may exceed the ceilings; recorded on the request"><input type="checkbox" name="override"/>override limits</label>
						}
						<button type="submit" class="btn-primary">Request</button>
					</div>
					<div id="form-error" class="refusal"></div>
					<p class="help">{ limitsNote(pg) }</p>
				</form>
			</div>
		</section>
		if errMsg != "" {
			<p class="error page-error">@icon("alert")<span>{ errMsg }</span></p>
		}
		@pendingCard(pg)
		@accountsTable(pg, rows)
		<p class="help">
			if pg.SignIn && !pg.Viewer.Admin {
				You see the accounts you own.
			}
			Spend is month to date from Cost Explorer and lags about a day.
		</p>
	}
}

templ pendingCard(pg page) {
	<section id="pending" class="panel" hx-swap-oob="true" aria-labelledby="pending-title">
		<div class="panel-head">
			<h2 id="pending-title">
				if pg.Viewer.Approver {
					Pending approvals
				} else {
					Your pending requests
				}
				<span class="muted">({ fmt.Sprint(len(pg.Pending)) })</span>
			</h2>
		</div>
		// A refused decision on a row shows here, beside the rows, and not in
		// the New request form.
		<div id="pending-error" class="refusal"></div>
		if len(pg.Pending) == 0 {
			<p class="empty">Nothing waiting.</p>
		} else {
			<div class="scroll">
				<table class="pending">
					<thead><tr><th scope="col">Name</th><th scope="col">Owner</th><th scope="col">Requested by</th><th scope="col">TTL</th><th scope="col">Budget</th><th scope="col">Purpose</th><th scope="col">When</th><th scope="col"><span class="vh">Actions</span></th></tr></thead>
					<tbody>
						for _, q := range pg.Pending {
							@pendingRow(pg, q)
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

// pendingRow is one request in the queue. Each action button carries the
// request name for screen readers, so "Approve" says which request.
templ pendingRow(pg page, q core.Request) {
	<tr id={ "req-" + q.Name }>
		<td>{ q.Name }</td>
		<td class="wrap">@breakable(q.Owner)</td>
		<td class="wrap">@breakable(q.RequestedBy) <span class="muted via">via { q.Via }</span></td>
		<td>{ core.Lifetime(q.TTL) }</td>
		<td>{ core.Dollars(q.BudgetUSD) }</td>
		<td class="wrap">
			{ q.Purpose }
			if q.OverrideLimits {
				<span class="flag" title="an admin allowed values above the ceilings">limits overridden</span>
			}
		</td>
		<td title={ q.RequestedAt.Format(time.RFC3339) }>{ q.RequestedAt.Format("Jan 2 15:04") }</td>
		<td class="actions">
			<div class="row-actions">
				if canApprove(pg, q) {
					<form class="inline" hx-post={ "/requests/" + q.Name + "/approve" } hx-target="#accounts" hx-swap="outerHTML" hx-include="#show-closed">
						@versionField(q)
						<button type="submit" class="btn-approve">
							@icon("stamp")
							Approve<span class="vh">{ " " + q.Name }</span>
						</button>
					</form>
					<form class="inline" hx-post={ "/requests/" + q.Name + "/deny" } hx-target="#accounts" hx-swap="outerHTML" hx-include="#show-closed" hx-prompt="Reason for denying (shown in the notice and in history)">
						@versionField(q)
						<button type="submit">Deny<span class="vh">{ " " + q.Name }</span></button>
					</form>
				} else if pg.Viewer.Approver {
					<span class="chip-mine" title="you requested this; another approver must act">Your request</span>
				}
				if pg.Viewer.Admin {
					<button hx-get={ "/requests/" + q.Name + "/edit" } hx-target={ "#req-" + q.Name } hx-swap="outerHTML" title="change owner, days, budget, or purpose before approving">Edit<span class="vh">{ " " + q.Name }</span></button>
				}
				if canWithdraw(pg.Viewer, q) {
					<form class="inline" hx-post={ "/requests/" + q.Name + "/withdraw" } hx-target="#accounts" hx-swap="outerHTML" hx-include="#show-closed" hx-confirm={ "Withdraw the request for " + q.Name + "?" }>
						@versionField(q)
						<button type="submit">Withdraw<span class="vh">{ " " + q.Name }</span></button>
					</form>
				}
			</div>
		</td>
	</tr>
}

// versionField binds a form to the request version this row shows, so the
// click is refused if the request changed or was replaced since.
templ versionField(q core.Request) {
	<input type="hidden" name="version" value={ q.Version() }/>
}

// breakable renders an identity with a break opportunity after the @, so a
// narrow column splits "name@" / "host" instead of mid-word.
templ breakable(s string) {
	if user, host, ok := strings.Cut(s, "@"); ok {
		{ user + "@" }<wbr/>{ host }
	} else {
		{ s }
	}
}

// pendingEditRow is the inline edit form. Every field holds the exact stored
// value, and editSave sends only the fields that differ from it. The days
// input takes part of a day, such as 1.5 for 36 hours, and the budget input
// takes cents. The server refuses zero days.
templ pendingEditRow(pg page, q core.Request) {
	<tr id={ "req-" + q.Name }>
		<td>{ q.Name }</td>
		<td colspan="6">
			<form hx-post={ "/requests/" + q.Name + "/edit" } hx-target="#accounts" hx-swap="outerHTML" hx-include="#show-closed">
				@versionField(q)
				<div class="form-row">
					<label class="field">owner<input name="owner" value={ q.Owner } size="24"/></label>
					<label class="field">{ dayLabel(q.TTL) }<input name="ttl" type="number" min="0" step="any" value={ dayValue(q.TTL) } class="in-days"/></label>
					<label class="field">budget $<input name="budget" type="number" min="0.01" step="0.01" value={ budgetValue(q.BudgetUSD) } class="in-budget"/></label>
					<label class="field">purpose<input name="purpose" value={ q.Purpose } size="28" maxlength={ fmt.Sprint(core.MaxPurpose) } pattern={ tagPattern } title="letters, numbers, spaces, and _ . : / = + - @"/></label>
					<label class="check" title="allow values above the ceilings"><input type="checkbox" name="override" checked?={ q.OverrideLimits }/>override limits</label>
					<button type="submit" class="btn-primary">Save</button>
					<button type="button" hx-get={ "/requests/" + q.Name + "/row" } hx-target={ "#req-" + q.Name } hx-swap="outerHTML">Cancel</button>
				</div>
			</form>
		</td>
		<td></td>
	</tr>
}

templ accountsTable(pg page, rows []accountRow) {
	<section id="accounts" class="panel" hx-get={ tableURL(pg.ShowAll) } hx-trigger="every 15s" hx-swap="outerHTML" aria-labelledby="accounts-title">
		<div class="panel-head">
			<h2 id="accounts-title">
				if pg.SignIn && !pg.Viewer.Admin {
					Your accounts
				} else {
					Accounts
				}
				<span class="muted">({ fmt.Sprint(len(rows)) })</span>
			</h2>
			<label class="check" title="include accounts AWS explicitly reports CLOSED"><input id="show-closed" type="checkbox" name="all" value="1" checked?={ pg.ShowAll } hx-get="/accounts" hx-target="#accounts" hx-swap="outerHTML" hx-trigger="change"/>Show closed</label>
		</div>
		<div class="scroll">
			<table class="fleet">
				<thead>
					<tr><th scope="col">Name</th><th scope="col">Owner</th><th scope="col">Status</th><th scope="col">Account</th><th scope="col">Expires</th><th scope="col">Spend / Budget</th><th scope="col"><span class="vh">Actions</span></th></tr>
				</thead>
				<tbody>
					if len(rows) == 0 {
						<tr><td colspan="7" class="muted">
							if pg.ShowAll {
								No accounts.
							} else {
								No open accounts.
							}
						</td></tr>
					}
					for _, r := range rows {
						@accountTR(r)
					}
				</tbody>
			</table>
		</div>
	</section>
}

// accountTR is one row of the fleet table. A placement wait is settling, not
// a failure, so it is a qualifier with a clock. Errors are red with an alert.
templ accountTR(r accountRow) {
	<tr>
		<td><a href={ templ.SafeURL("/accounts/" + r.Account.ID) }>{ r.Account.Name }</a></td>
		<td><span class="owner" title={ r.Account.Owner }>{ r.Account.Owner }</span></td>
		<td>
			@statusLabel(r.Account)
			if r.Account.LastError != "" && r.Account.Status == core.StatusCreating {
				<div class="qualifier">@icon("clock")<span>{ r.Account.LastError }</span></div>
			} else if r.Account.LastError != "" {
				<div class="error">@icon("alert")<span>{ r.Account.LastError }</span></div>
			}
			if r.Account.RepairError() != nil {
				<div class="error">@icon("alert")<span>{ r.Account.RepairError().Error() }</span></div>
			}
		</td>
		<td><code>{ r.Account.ProviderID }</code></td>
		<td title={ expiryDate(r.Account.ExpiresAt, time.RFC3339) }>
			if r.Account.Status == core.StatusActive || r.Account.Status == core.StatusExpiring || r.Account.Status == core.StatusClosing {
				{ expiresIn(r.Account.ExpiresAt) }
			} else if !r.Account.ExpiresAt.IsZero() && r.Account.Status != core.StatusFailed && r.Account.Status != core.StatusClosed {
				<span class="muted" title="once created">{ expiresIn(r.Account.ExpiresAt) }</span>
			} else {
				<span class="muted">—</span>
			}
		</td>
		<td>
			<div class="spend">{ fmt.Sprintf("$%.2f / %s", r.Spend, budgetAmount(r.Account.BudgetUSD)) }</div>
			if r.Account.BudgetUSD > 0 {
				@meterLine(spendMeter(r.Spend, r.Account.BudgetUSD, meterWidth), fmt.Sprintf("$%.2f of $%.2f", r.Spend, r.Account.BudgetUSD))
			}
			@budgetLabel(r.Account.BudgetHealth, r.Account.BudgetError)
		</td>
		<td class="actions">
			<div class="row-actions">
				if r.Account.CanExtend() {
					<form class="inline" hx-post={ "/accounts/" + r.Account.ID + "/extend" } hx-target="#accounts" hx-swap="outerHTML" hx-include="#show-closed">
						<input type="hidden" name="by" value="7d"/>
						<button type="submit" title="extend by 7 days" class="btn-approve">
							@icon("stamp")
							+7d<span class="vh">{ " " + r.Account.Name }</span>
						</button>
					</form>
				}
				if r.Account.Status.CanClose() {
					<form class="inline" hx-post={ "/accounts/" + r.Account.ID + "/close" } hx-target="#accounts" hx-swap="outerHTML" hx-include="#show-closed" hx-confirm={ "Request closure of " + r.Account.Name + "? AWS processes closure asynchronously. Charges may continue while pending, and commitments or subscriptions can outlive closure." }>
						<button type="submit">Close<span class="vh">{ " " + r.Account.Name }</span></button>
					</form>
				}
			</div>
		</td>
	</tr>
}

// statusLabel is the icon and the word of an account status. A closing
// account with an error is an overdue closure, so its box turns red.
templ statusLabel(a *core.Account) {
	<span class={ "status", "status-" + string(a.Status), templ.KV("status-overdue", a.Status == core.StatusClosing && a.LastError != "") }>@icon(statusIcon(a.Status))<span>{ string(a.Status) }</span></span>
}

// budgetLabel is the icon and the word of a budget protection state. The
// error text, if any, is the tooltip. A settling state adds a qualifier.
templ budgetLabel(health, errText string) {
	{{ look, word := budgetState(health) }}
	<span
		class={ "status", "budget-" + look.Tone }
		if errText != "" {
			title={ errText }
		}
	>@icon(look.Icon)<span>{ word }</span></span>
	if look.Settling {
		<span class="qualifier">settling protection</span>
	}
}

// meterLine draws the spend meter as SVG. The fill length is a width
// attribute and the colors come from classes, because the CSP allows no
// inline style. The label sits to the right, so the row stays one line.
templ meterLine(m meter, title string) {
	<div class={ "meter-line", "meter-" + m.Level } title={ title }>
		<svg class="meter" width={ strconv.Itoa(meterWidth) } height="4" viewBox={ "0 0 " + strconv.Itoa(meterWidth) + " 4" } aria-hidden="true" focusable="false"><rect class="meter-track" width={ strconv.Itoa(meterWidth) } height="4" rx="2"></rect><rect class="meter-fill" width={ strconv.Itoa(m.Fill) } height="4" rx="2"></rect></svg>
		if m.Label != "" {
			<span class="meter-label">
				if m.Level == "near" || m.Level == "over" {
					@icon("alert")
				}
				{ m.Label }
			</span>
		}
	</div>
}

templ accountPage(pg page, a *core.Account, costs []core.CostPoint, total float64, history historyView) {
	@layout(pg, a.Name) {
		<section class="panel" aria-labelledby="account-title">
			<div class="panel-head">
				<h1 id="account-title">{ a.Name }</h1>
				@statusLabel(a)
			</div>
			<div class="panel-body">
				<dl class="facts">
					<dt>owner</dt><dd>{ a.Owner }</dd>
					<dt>account id</dt>
					<dd>
						if a.ProviderID == "" {
							<span class="muted">{ notCreated(a) }</span>
						} else {
							<code>{ a.ProviderID }</code>
						}
					</dd>
					if a.RequestID != "" {
						// Courier Prime is only for account IDs and request versions,
						// so the creation request id is plain text.
						<dt>request id</dt><dd>{ a.RequestID }</dd>
					}
					<dt>root email</dt>
					<dd>
						if a.Email == "" {
							<span class="muted">{ notCreated(a) }</span>
						} else {
							{ a.Email }
						}
					</dd>
					<dt>budget</dt><dd>{ budgetAmount(a.BudgetUSD) } / month</dd>
					<dt>budget protection</dt>
					<dd>
						@budgetLabel(a.BudgetHealth, a.BudgetError)
						if a.BudgetChecked != "" {
							<span class="muted">(last state observation: { a.BudgetChecked })</span>
						}
					</dd>
					if a.BudgetError != "" {
						<dt>budget error</dt><dd class="error">@icon("alert")<span>{ a.BudgetError }</span></dd>
					}
					<dt>spend, 30 days</dt><dd>{ fmt.Sprintf("$%.2f", total) }</dd>
					<dt>created</dt><dd>{ a.CreatedAt.Format("2006-01-02 15:04 MST") }</dd>
					if a.ProviderID != "" {
						<dt>expires</dt><dd>{ expiryDate(a.ExpiresAt, "2006-01-02 15:04 MST") }
							if !a.ExpiresAt.IsZero() {
								<span class="muted">({ expiresIn(a.ExpiresAt) })</span>
							}
						</dd>
					}
					if a.WarnedAt != nil {
						<dt>expiring notice sent</dt><dd>{ a.WarnedAt.Format("2006-01-02 15:04 MST") }</dd>
					}
					if a.CloseRequestedAt != nil {
						<dt>close requested</dt><dd>{ a.CloseRequestedAt.Format("2006-01-02 15:04 MST") }</dd>
					}
					if a.LastError != "" && a.Status == core.StatusCreating {
						// A creation that waits in the root for placement: a qualifier, not a failure.
						<dt>placement</dt><dd class="qualifier">@icon("clock")<span>{ a.LastError }</span></dd>
					} else if a.LastError != "" {
						<dt>failure</dt><dd class="error">@icon("alert")<span>{ a.LastError }</span></dd>
					}
					if a.RepairError() != nil {
						<dt>repair required</dt><dd class="error">@icon("alert")<span>{ a.RepairError().Error() }</span></dd>
					}
					if !a.Managed {
						<dt>note</dt><dd class="muted">not yet tagged by playplace; the next sync adopts it</dd>
					}
				</dl>
			</div>
		</section>
		if pg.Viewer.Admin && a.Managed && a.Status.CanExtend() && a.RepairError() == nil {
			<section class="panel" aria-labelledby="budget-title">
				<div class="panel-head"><h2 id="budget-title">Change monthly budget</h2></div>
				<div class="panel-body">
					<p class="lede">An increase above reported spend can lift the provisioning restriction and rearm enforcement. AWS billing and policy changes are delayed. Existing resources keep charging.</p>
					<form hx-post={ "/accounts/" + a.ID + "/budget" }>
						<div class="form-row">
							<label class="field">USD per month<input name="budget" type="number" min="0.01" step="0.01" value={ fmt.Sprintf("%.2f", a.BudgetUSD) } required class="in-budget"/></label>
							<label class="field">reason<input name="reason" maxlength="500" required/></label>
							<label class="check"><input type="checkbox" name="override"/>override budget ceiling</label>
							<button type="submit" class="btn-primary">Save budget</button>
						</div>
					</form>
					<div id="form-error" class="refusal"></div>
				</div>
			</section>
		}
		if history.Enabled {
			<section class="panel" aria-labelledby="history-title">
				<div class="panel-head">
					<h2 id="history-title">History</h2>
					if history.OrderURL != "" {
						<a class="link" href={ templ.SafeURL(history.OrderURL) }>
							if history.OldestFirst {
								Show newest first
							} else {
								Show oldest first
							}
						</a>
					}
				</div>
				if history.Notice != "" {
					<p class="empty">{ history.Notice }</p>
				}
				if history.Error != "" {
					<div class="panel-body"><p class="error page-error" role="alert">@icon("alert")<span>{ history.Error }</span></p></div>
				} else if len(history.Page.Events) == 0 && !history.Page.Incomplete {
					<p class="empty">Nothing recorded yet for this journey.</p>
				} else if len(history.Page.Events) > 0 {
					<div class="scroll">
						<table class="history">
							<thead><tr><th scope="col">When</th><th scope="col">Event</th><th scope="col">By</th><th scope="col">What happened</th></tr></thead>
							<tbody>
								for _, e := range history.Page.Events {
									<tr>
										<td title={ e.At.Format(time.RFC3339Nano) }>{ e.At.UTC().Format("2006-01-02 15:04:05 MST") }</td>
										<td><span class="event">{ e.Event }</span></td>
										<td>{ e.Actor }
											if e.Via != "" {
												<span class="muted">via { e.Via }</span>
											}
										</td>
										<td class="wrap">{ e.Message }
											if len(e.Details) > 0 {
												<details><summary>Details</summary><pre>{ historyDetails(e) }</pre></details>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>
		}
		if history.Enabled && history.Page.Incomplete {
			<p class="banner-incomplete" role="alert">@icon("alert")<span>History is incomplete: some stored records could not be read.</span></p>
		}
		if history.NextURL != "" {
			<p><a class="link" href={ templ.SafeURL(history.NextURL) }>Next history page</a></p>
		}
		<section class="panel panel-fit" aria-labelledby="spend-title">
			<div class="panel-head"><h2 id="spend-title">Daily spend</h2></div>
			if len(costs) == 0 {
				<p class="empty">No cost data yet.</p>
			} else {
				<div class="scroll">
					<table class="daily">
						<thead><tr><th scope="col">Date</th><th scope="col" class="num">USD</th></tr></thead>
						<tbody>
							for i := len(costs) - 1; i >= 0; i-- {
								<tr><td>{ costs[i].Date.Format("2006-01-02") }</td><td class="num">{ fmt.Sprintf("%.2f", costs[i].AmountUSD) }</td></tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}

templ noticeFragment(msg string) {
	<p id="notice" class="notice" hx-swap-oob="true">@icon("sync")<span>{ msg }</span></p>
}

// errorFragment fills the refusal slot with this id: form-error under a form,
// or pending-error in the pending card. It names what went wrong beside the
// thing it is about, with an alert icon.
templ errorFragment(id, msg string) {
	<div id={ id } class="refusal" hx-swap-oob="true">@icon("alert")<span>{ msg }</span></div>
}
