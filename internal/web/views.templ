package web

import (
	"fmt"
	"strconv"
	"strings"
	"time"

	"playplace/internal/core"
)

// layout is the frame of every page. The htmx config turns off eval and the
// indicator style element that htmx adds to the head, because the CSP blocks
// both. idiomorph loads after htmx and before app.js, because app.js defines
// the morph extension that calls both.
templ layout(pg page, title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · playplace</title>
			<link rel="icon" href={ asset("favicon.svg") } type="image/svg+xml"/>
			<link rel="icon" href={ asset("favicon.ico") } sizes="32x32"/>
			<link rel="apple-touch-icon" href={ asset("apple-touch-icon.png") }/>
			<link rel="stylesheet" href={ asset("app.css") }/>
			<meta name="htmx-config" content='{"allowEval":false,"selfRequestsOnly":true,"includeIndicatorStyles":false}'/>
			<script src={ asset("htmx.min.js") }></script>
			<script src={ asset("idiomorph.min.js") }></script>
			<script src={ asset("app.js") }></script>
		</head>
		<body hx-ext="morph">
			@iconSprite()
			@shell(pg)
			if !pg.SignIn {
				<div class="noauth" role="note">@icon("alert")<span>Sign-in is off. Every visitor is an admin.</span></div>
			}
			<main>
				if !pg.RegionInCard {
					@region()
				}
				{ children... }
			</main>
		</body>
	</html>
}

// region is the page's one live region. The node stays from page load and
// htmx writes into it, so screen readers keep listening to it. Nothing sits
// inside it at rest. Most pages hold it at the top of main. The home page
// holds it in the queue panel, next to the decisions. An approver has it in
// the bulk bar, and anyone else has it under the head of Your requests.
templ region() {
	<p id="notice" class="notice" role="status" aria-live="polite"></p>
}

// shell is the bar on every page. The links depend on the role: engineers
// get Home, approvers also get Queue with its count, and admins get Queue
// and Accounts, because the brand is their link home. The menu toggle comes
// right after the brand, so the next Tab after it enters the menu. On a phone
// the in-menu items hide behind it, and Queue and Sync stay in the bar. A
// page for nobody, such as a failed sign-in, shows only the brand. Only the
// home page has the accounts section, so Sync on any other page swaps
// nothing, and its answer writes only into the live region.
templ shell(pg page) {
	<header class="shell">
		<a class="brand" href="/"><svg class="mark" aria-hidden="true" focusable="false"><use href="#i-mark"></use></svg><span class="brand-word"><b>play</b><span class="place">place</span></span></a>
		if !pg.SignedOut {
			<button type="button" class="menu-toggle" aria-expanded="false" aria-controls="shell-menu">@icon("menu")<span class="vh">Menu</span></button>
			<div id="shell-menu" class="shell-menu">
				<nav class="nav" aria-label="Main">
					<ul>
						if !pg.Viewer.Admin {
							<li class="in-menu">
								<a
									class="nav-link"
									href="/"
									if pg.Path == "/" {
										aria-current="page"
									}
								>Home</a>
							</li>
						}
						if pg.Viewer.Approver {
							<li>
								<a class="nav-link" href="/#pending">
									Queue
									@queueCount(pg, false)
								</a>
							</li>
						}
						if pg.Viewer.Admin {
							<li class="in-menu"><a class="nav-link" href="/#accounts">Accounts</a></li>
						}
					</ul>
				</nav>
				if pg.Viewer.Admin {
					<form
						class="sync"
						hx-post="/refresh"
						if pg.Path == "/" {
							hx-target="#accounts"
							hx-swap="morph"
							hx-include="#show-closed"
						} else {
							hx-target="#notice"
							hx-swap="none"
						}
						hx-sync="this:drop"
					>
						// The word cell is also the phone's hidden word, so the phone rule
						// hides both words and a screen reader still hears the busy verb.
						<button type="submit" class="btn-ghost" title="poll creations, sweep expiry, retry closes">@icon("sync")<span class="btn-word word"><span>Sync with AWS</span><span class="busy">Syncing</span></span></button>
					</form>
				}
				<a class="btn btn-chip in-menu" href="/#request">
					@icon("plus")
					New request
				</a>
				if pg.SignIn {
					<span class="person in-menu">
						<span class="person-email">{ pg.Viewer.Email }</span>
						if pg.Viewer.Admin {
							<span class="badge">admin</span>
						}
					</span>
					<form class="signout in-menu" method="post" action="/auth/logout"><button type="submit" class="nav-link">Sign out</button></form>
				}
			</div>
		}
	</header>
}

// queueCount is the number of pending requests beside Queue. It is empty at
// zero. The vh word tells a screen reader what the number counts.
templ queueCount(pg page, oob bool) {
	<span
		id="queue-count"
		if oob {
			hx-swap-oob="true"
		}
	>
		if len(pg.Pending) > 0 {
			<span class="count-pill">{ fmt.Sprint(len(pg.Pending)) }<span class="vh">{ " pending requests" }</span></span>
		}
	</span>
}

// pendingUpdate is the queue panel for an htmx answer. Approvers also get
// the shell count, so the two never disagree. Other viewers have no Queue
// link. A count with no target makes htmx log an error.
templ pendingUpdate(pg page) {
	@queuePanel(pg, true)
	if pg.Viewer.Approver {
		@queueCount(pg, true)
	}
}

// accountsAnswer answers the poll and every request from outside the
// queue panel: the accounts section is the main swap, and the queue panel
// rides out of band. When the queue did not load, the panel and the count
// stay out, so the page keeps the ones it shows. Rendered with no hash, it
// is also what the poll hash covers.
templ accountsAnswer(pg page, rows []accountRow, errMsg, hash string) {
	@accountsPanel(pg, rows, errMsg, hash, false)
	if !pg.PendingFailed {
		@pendingUpdate(pg)
	}
}

// cardAnswer answers a decision made in the queue panel. The panel is the
// main swap, because htmx finds the morph extension from the form that
// sent the request. An out-of-band part runs first and can take that form
// out of the page. The accounts section and the count ride out of band.
// errMsg is the refusal text of an account list that failed after the
// decision, so the section shows its failed panel.
templ cardAnswer(pg page, rows []accountRow, errMsg, hash string) {
	@queuePanel(pg, false)
	@accountsPanel(pg, rows, errMsg, hash, true)
	if pg.Viewer.Approver && !pg.PendingFailed {
		@queueCount(pg, true)
	}
}

// busyWord is the word of a button and its verb in progress, in one grid
// cell. The button keeps the width of its word, and the verb spills into
// the side padding, so a busy button keeps its size. app.js sets
// aria-busy on the button while its request runs, and the stylesheet then
// shows the busy verb. The hidden word is left out of the accessible name.
templ busyWord(word, busy string) {
	<span class="word"><span>{ word }</span><span class="busy">{ busy }</span></span>
}

// icon draws one symbol of the sprite. It sits next to a word, so screen
// readers skip it.
templ icon(name string) {
	<svg class="i" aria-hidden="true" focusable="false"><use href={ "#i-" + name }></use></svg>
}

// iconSprite holds every icon and the mark as symbols on a 24 px grid. The
// symbols carry no fill or stroke: the .i and .mark rules in app.css set
// them, and <use> passes currentColor down.
templ iconSprite() {
	<svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
		<symbol id="i-mark" viewBox="0 0 24 24"><path d="M7.4 18.6h9.9a3.9 3.9 0 0 0 .4-7.8 5.6 5.6 0 0 0-10.7-1.1 4.5 4.5 0 0 0 .4 8.9z"></path><path d="M8.6 16.2c2.6 0 3.1-3.6 6.2-3.6"></path><circle cx="16" cy="15.6" r="1.1"></circle></symbol>
		<symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M8.6 12.3l2.4 2.4 4.5-5"></path></symbol>
		<symbol id="i-clock-arc" viewBox="0 0 24 24"><path d="M12 3.5a8.5 8.5 0 1 1-8.5 8.5"></path><path d="M12 8v4l2.5 1.5"></path></symbol>
		<symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path></symbol>
		<symbol id="i-hourglass" viewBox="0 0 24 24"><path d="M7 3.5h10M7 20.5h10M8 3.5v2.3a4 4 0 0 0 1.6 3.2L12 12l2.4-3a4 4 0 0 0 1.6-3.2V3.5M8 20.5v-2.3a4 4 0 0 1 1.6-3.2L12 12l2.4 3a4 4 0 0 1 1.6 3.2v2.3"></path></symbol>
		<symbol id="i-box" viewBox="0 0 24 24"><path d="M4 4.5h16v4H4zM5.5 8.5V19h13V8.5M12 11v5M9.5 13.5L12 16l2.5-2.5"></path></symbol>
		<symbol id="i-ban" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M6 6l12 12"></path></symbol>
		<symbol id="i-x-circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M9.2 9.2l5.6 5.6M14.8 9.2l-5.6 5.6"></path></symbol>
		<symbol id="i-minus" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M8 12h8"></path></symbol>
		<symbol id="i-dashed-circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" stroke-dasharray="2.4 3"></circle></symbol>
		<symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="1.5"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></symbol>
		<symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 4l9 16H3z"></path><path d="M12 10v4.2M12 17.2v.1"></path></symbol>
		<symbol id="i-sync" viewBox="0 0 24 24"><path d="M19.5 11a7.5 7.5 0 0 0-13.4-4.2L4.5 8.5M4.5 4v4.5H9M4.5 13a7.5 7.5 0 0 0 13.4 4.2l1.6-1.7M19.5 20v-4.5H15"></path></symbol>
		<symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></symbol>
		<symbol id="i-stamp" viewBox="0 0 24 24"><circle cx="12" cy="5.5" r="2.3"></circle><path d="M10.6 7.7V11M13.4 7.7V11"></path><rect x="4.5" y="11" width="15" height="4.5" rx="1"></rect><path d="M5 19.5h14"></path></symbol>
		<symbol id="i-unlock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="1.5"></rect><path d="M8 11V8a4 4 0 0 1 7.6-1.7"></path></symbol>
		<symbol id="i-slip" viewBox="0 0 24 24"><rect x="5.5" y="3.5" width="13" height="17" rx="1.5"></rect><path d="M8.5 8h7M8.5 11.5h7M8.5 15h4"></path></symbol>
		<symbol id="i-door" viewBox="0 0 24 24"><path d="M3.5 20.5h17M6.5 20.5v-16a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16"></path><path d="M14.5 12.5v.01"></path></symbol>
		<symbol id="i-bell" viewBox="0 0 24 24"><path d="M6.5 16.5V11a5.5 5.5 0 0 1 11 0v5.5l1.5 2h-14z"></path><path d="M10 21h4"></path></symbol>
		<symbol id="i-bell-off" viewBox="0 0 24 24"><path d="M6.5 16.5V11a5.5 5.5 0 0 1 11 0v5.5l1.5 2h-14z"></path><path d="M10 21h4"></path><path d="M4 4l16 16"></path></symbol>
		<symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"></path></symbol>
		<symbol id="i-chevron-right" viewBox="0 0 24 24"><path d="M9.5 6l6 6-6 6"></path></symbol>
		<symbol id="i-chevron-down" viewBox="0 0 24 24"><path d="M6 9.5l6 6 6-6"></path></symbol>
	</svg>
}

type accountRow struct {
	Account *core.Account
	Spend   float64 // month to date
}


// indexPage is the home page. The shell is the visible heading, so the page
// h1 is for screen readers only.
templ indexPage(pg page, rows []accountRow, errMsg, hash string) {
	@layout(regionInCard(pg), "Accounts") {
		<h1 class="vh">Accounts</h1>
		<section class="panel" id="request" aria-labelledby="request-title">
			<div class="panel-head"><h2 id="request-title">New request</h2></div>
			<div class="panel-body">
				<form hx-post="/requests" hx-target="#accounts" hx-swap="morph" hx-include="#show-closed" data-reset-on-success hx-sync="this:drop">
					<div class="form-row">
						<label class="field">name<input name="name" required pattern="[a-z0-9][a-z0-9\-]{1,48}[a-z0-9]" placeholder="dev-alex"/></label>
						if pg.Viewer.Admin {
							<label class="field">owner<input name="owner" placeholder="owner email" value={ ownerDefault(pg.Viewer) }/></label>
						} else {
							<label class="field">owner<input value={ pg.Viewer.Email } disabled title="requests are always in your name"/></label>
						}
						if pg.Viewer.Admin {
							<label class="field">days<input name="ttl" type="number" min="1" placeholder={ dayCount(pg.Limits.DefaultTTL) } title={ "up to " + dayCount(pg.Limits.MaxTTL) + " unless overridden" } class="in-days"/></label>
							<label class="field">budget $<input name="budget" type="number" min="1" placeholder={ fmt.Sprintf("%.0f", pg.Limits.DefaultBudgetUSD) } title={ fmt.Sprintf("up to $%.0f unless overridden", pg.Limits.MaxBudgetUSD) } class="in-budget"/></label>
						} else {
							<label class="field">days<input name="ttl" type="number" min="1" max={ dayCount(pg.Limits.MaxTTL) } placeholder={ dayCount(pg.Limits.DefaultTTL) } title={ "up to " + dayCount(pg.Limits.MaxTTL) } class="in-days"/></label>
							<label class="field">budget $<input name="budget" type="number" min="1" max={ fmt.Sprintf("%.0f", pg.Limits.MaxBudgetUSD) } placeholder={ fmt.Sprintf("%.0f", pg.Limits.DefaultBudgetUSD) } title={ fmt.Sprintf("up to $%.0f", pg.Limits.MaxBudgetUSD) } class="in-budget"/></label>
						}
						<label class="field">purpose<input name="purpose" placeholder="what you will try" size="24" maxlength={ fmt.Sprint(core.MaxPurpose) } pattern={ tagPattern } title="letters, numbers, spaces, and _ . : / = + - @"/></label>
						if pg.Viewer.Admin {
							<label class="check" title="admins may exceed the ceilings; recorded on the request"><input type="checkbox" name="override"/>override limits</label>
						}
						<button type="submit" class="btn-primary">@busyWord("Request", "Sending")</button>
					</div>
					<div id="form-error" class="refusal"></div>
					<p class="help">{ limitsNote(pg) }</p>
				</form>
			</div>
		</section>
		@queuePanel(pg, false)
		// errMsg is the refusal text of a failed account load. The panel
		// shows it, so the next good poll clears it.
		@accountsPanel(pg, rows, errMsg, hash, false)
		<p class="help">
			if pg.SignIn && !pg.Viewer.Admin {
				You see the accounts you own.
			}
			Spend is month to date from Cost Explorer and lags about a day.
		</p>
	}
}

// queuePanel is the queue of the home page. An approver gets the approval
// desk, and anyone else gets Your requests. oob marks it as an out-of-band
// part of an htmx answer, which htmx morphs into the panel on the page. The
// panel holds the live region of the home page. Every answer renders the
// empty node, so a morph pairs it by id, and app.js keeps the node as it is.
templ queuePanel(pg page, oob bool) {
	if pg.Viewer.Approver {
		@approvalDesk(pg, oob)
	} else {
		@ownRequests(pg, oob)
	}
}

// approvalDesk is the approval queue of an approver: card stock, the
// bulk bar and the slips, oldest first. The bar holds the live region
// and the refusal slot in every state, so a morph pairs them by id. A
// queue that did not load says so, because an empty list reads as an
// empty queue.
templ approvalDesk(pg page, oob bool) {
	{{ items, slips, line := pg.left(), pg.slips(), deskLine(pg) }}
	<section
		id="pending"
		class="panel desk"
		if oob {
			hx-swap-oob="morph"
		}
		aria-labelledby="pending-title"
	>
		// app.js moves the focus to the heading when no slip waits, so the
		// heading takes focus from script only.
		<div class="panel-head">
			<h2 id="pending-title" tabindex="-1">Approval queue</h2>
			if line != "" {
				<p class="panel-line">{ line }</p>
			}
		</div>
		<div id="desk-bar" class="desk-bar">
			@region()
			<div id="pending-error" class="refusal">
				if len(items) > 0 {
					@leftNote(items)
				}
			</div>
		</div>
		if pg.PendingFailed {
			@queueFailed()
		} else if len(slips) == 0 {
			<div id="pending-empty" class="desk-empty">
				@icon("stamp")
				<div class="note-text">
					<p class="note-title">No requests are waiting.</p>
					if pg.InSlack {
						<p class="note-body">New requests appear here and in Slack.</p>
					}
				</div>
			</div>
		} else {
			<ol class="slips" role="list">
				for _, s := range slips {
					@slip(pg, s)
				}
			</ol>
		}
	</section>
}

// leftNote fills the refusal slot of the queue with the lines that have
// no slip. They are the results of a decision post that have no place,
// and the request of the address that the queue does not list. Each line
// names its request, because no slip gives it a place.
templ leftNote(items []leftItem) {
	@icon("alert")
	if len(items) == 1 {
		<span data-name={ items[0].Name }>{ items[0].Text }</span>
	} else {
		<ul class="note-list">
			for _, it := range items {
				<li data-name={ it.Name }>{ it.Text }</li>
			}
		</ul>
	}
}

// queueFailed says that the queue did not load. It has an id, so a morph
// never pairs it with the list that replaces it.
templ queueFailed() {
	<div id="pending-failed" class="refusal">@icon("alert")<div class="note-text"><p class="note-title">The pending requests are unavailable.</p><p class="note-body">The page tries again with the next live update.</p></div></div>
}

// slip is one slip of the approval desk. It shows a request that waits, a
// request that this answer decided, or a request that left the queue. The
// parts come in the order that a phone and a screen reader use, so every
// deciding fact comes before Approve and Deny. The server has only the name
// and the time of a request that left, so a gone slip shows the name and
// the note. Each button names its request for screen readers. Each control
// whose answer takes the focused button away names its action, so app.js
// knows where the focus goes next.
templ slip(pg page, s slipView) {
	// Each state has its own li, so the parts of a slip are children of an
	// element. In the body of an if, templ writes a space after a component.
	if s.decided() {
		<li id={ "req-" + s.Req.Name } class="slip" data-state={ s.state() } data-result={ s.Result.Kind.String() }>
			<span class="slip-pick"></span>
			<div class="slip-main">
				<div class="slip-top">
					<h3 class="slip-title"><span class="slip-name">{ s.Req.Name }</span></h3>
					if s.Req.OverrideLimits {
						<span class="flag" title="an admin allowed values above the ceilings">limits overridden</span>
					}
				</div>
				@slipLines(pg.Viewer, s.Req)
			</div>
			@slipFacts(s)
			<div class="slip-actions">
				<span class={ "stamp", "stamp-word", "stamp-" + s.Result.Kind.String(), stampTurn(s.Req.Name), "stamp-new" }>{ s.Result.Kind.String() }</span>
				<p class="slip-version">{ "by you at version " }<code>{ versionLabel(s.Result.Ref.Version) }</code></p>
			</div>
			if s.Result.Kind == decidedApproved {
				<p class="slip-outcome">@icon("clock-arc")<span>AWS is creating the account. This takes a few minutes.</span></p>
			} else {
				<p class="slip-outcome"><span>{ "Reason: " + s.Result.Reason }</span></p>
			}
		</li>
	} else if s.Gone {
		<li id={ "req-" + s.Req.Name } class="slip" data-state={ s.state() } data-result={ s.Result.Kind.String() }>
			<span class="slip-pick"></span>
			<div class="slip-main">
				<div class="slip-top">
					<h3 class="slip-title"><span class="slip-name">{ s.Req.Name }</span></h3>
				</div>
			</div>
			<div class="slip-note" id={ "result-" + s.Req.Name }>@icon("alert")<span>{ s.Note }</span></div>
		</li>
	} else {
		<li
			id={ "req-" + s.Req.Name }
			class="slip"
			data-state={ s.state() }
			if s.Result != nil {
				data-result={ s.Result.Kind.String() }
			}
		>
			<span class="slip-pick"></span>
			<div class="slip-main">
				<div class="slip-top">
					<h3 class="slip-title"><button type="button" id={ "name-" + s.Req.Name } class="slip-name" aria-expanded={ strconv.FormatBool(pg.Open == s.Req.Name) } aria-controls={ slipControls(pg, s) }>@chevrons()<span>{ s.Req.Name }</span></button></h3>
					if s.changed() {
						<span class="flag flag-changed">changed after you loaded the page</span>
					}
					if s.Req.OverrideLimits {
						<span class="flag" title="an admin allowed values above the ceilings">limits overridden</span>
					}
				</div>
				@slipLines(pg.Viewer, s.Req)
			</div>
			@slipFacts(s)
			@slipDetails(pg, s)
			<div class="slip-actions">
				// The chip has no title, because a title never shows on a
				// touch screen or to a keyboard. A hidden sentence after it
				// says why, and so does the opened slip.
				if canApprove(pg, s.Req) {
					<div class="slip-decide">
						<form class="inline" hx-post={ "/requests/" + s.Req.Name + "/approve" } hx-target="#pending" hx-swap="morph" hx-include="#show-closed" hx-sync="this:drop" data-action="approve">
							@versionField(s.Req)
							@shownFields(s.Req)
							<button
								type="submit"
								class="btn-approve"
								if s.Note != "" {
									aria-describedby={ "result-" + s.Req.Name }
								}
							>@icon("stamp")@busyWord("Approve", "Approving")<span class="vh">{ " " + s.Req.Name }</span></button>
						</form>
						<form class="inline" hx-post={ "/requests/" + s.Req.Name + "/deny" } hx-target="#pending" hx-swap="morph" hx-include="#show-closed" hx-prompt="Reason for denying, 1 to 500 characters. playplace sends it with the denied notice and keeps it in history." hx-sync="this:drop" data-action="deny">
							@versionField(s.Req)
							@shownFields(s.Req)
							<button
								type="submit"
								if s.Note != "" {
									aria-describedby={ "result-" + s.Req.Name }
								}
							>@busyWord("Deny", "Denying")<span class="vh">{ " " + s.Req.Name }</span></button>
						</form>
					</div>
				} else if pg.Viewer.Approver {
					<div class="row-actions"><span class="chip-mine">Your request</span><span class="vh">{ " Another approver must decide this request." }</span></div>
				}
				<p class="slip-version">{ "version " }<code>{ versionLabel(s.Req.Version()) }</code>@sawVersion(s)</p>
			</div>
			if s.Note != "" {
				<div class="slip-note" id={ "result-" + s.Req.Name }>@icon("alert")<span>{ s.Note }</span></div>
			}
			@slipTools(pg, s.Req)
		</li>
	}
}

// slipLines are the purpose of a request and the meta line under it.
templ slipLines(v Viewer, q core.Request) {
	if strings.TrimSpace(q.Purpose) != "" {
		<p class="slip-purpose">{ q.Purpose }</p>
	} else {
		<p class="slip-purpose muted">The request has no purpose.</p>
	}
	<p class="slip-meta">{ metaLine(v, q) }</p>
}

// slipFacts are the facts that decide a request, beside Approve: the
// lifetime and the budget. A request that changed after the page showed
// it also shows the old value, struck.
templ slipFacts(s slipView) {
	<dl class="slip-facts">
		<div class="fact"><dt>Lifetime</dt><dd>@factWas(s.wasLifetime())<span class="fact-now">{ core.Lifetime(s.Req.TTL) }</span></dd></div>
		<div class="fact"><dt>Budget</dt><dd>@factWas(s.wasBudget())<span class="fact-now">{ core.Dollars(s.Req.BudgetUSD) }</span><span class="fact-unit">{ " a month" }</span></dd></div>
	</dl>
}

// factWas is the value of a fact that the page showed, struck, when it
// changed. It is a component, so templ writes no space after it.
templ factWas(was string, ok bool) {
	if ok {
		<span class="fact-was">{ "was " }<s>{ was }</s><span class="vh">{ ", now" }</span></span>
	}
}

// slipDetails is the opened part of a slip before its actions: every
// fact that decides it. It renders hidden, except for the slip of
// pg.Open. An approver who cannot decide the request reads why.
templ slipDetails(pg page, s slipView) {
	<div class="slip-details" id={ "details-" + s.Req.Name } hidden?={ pg.Open != s.Req.Name }>
		<dl class="slip-dl">
			<div><dt>Owner</dt><dd>@breakable(s.Req.Owner)</dd></div>
			<div><dt>Requester</dt><dd>@breakable(s.Req.RequestedBy)</dd></div>
			<div><dt>Channel</dt><dd>{ s.Req.Via }</dd></div>
			<div><dt>Requested</dt><dd>@utcTime(s.Req.RequestedAt)</dd></div>
			<div><dt>Lifetime</dt><dd>{ core.Lifetime(s.Req.TTL) }</dd></div>
			<div><dt>Budget</dt><dd>{ core.Dollars(s.Req.BudgetUSD) + " a month" }</dd></div>
			<div><dt>Limits check</dt><dd>{ limitsCheck(s.Req, pg.Limits) }</dd></div>
			<div><dt>Per-owner limit</dt><dd>{ ownerStanding(pg, s.Req) }</dd></div>
			if pg.Viewer.Admin {
				<div><dt>Owner also holds</dt><dd>{ otherHoldings(pg, s.Req) }</dd></div>
			}
			<div class="wide">
				<dt>Purpose</dt>
				<dd>
					if strings.TrimSpace(s.Req.Purpose) != "" {
						{ s.Req.Purpose }
					} else {
						The request has no purpose.
					}
				</dd>
			</div>
			<div><dt>Version</dt><dd><code>{ versionLabel(s.Req.Version()) }</code></dd></div>
			if pg.Limits.RequestTTL > 0 {
				<div><dt>Decide by</dt><dd>@utcTime(s.Req.DropsAt(pg.Limits.RequestTTL))</dd></div>
			}
		</dl>
		if pg.Viewer.Approver && !canApprove(pg, s.Req) {
			<p class="slip-own">Another approver must decide this request.</p>
		}
	</div>
}

// slipTools is the opened part of a slip after its note: Edit and
// Withdraw. It renders only for a viewer who has one of them, hidden
// except for the slip of pg.Open.
templ slipTools(pg page, q core.Request) {
	if hasTools(pg, q) {
		<div class="slip-tools" id={ "tools-" + q.Name } hidden?={ pg.Open != q.Name }>
			if pg.Viewer.Admin {
				<button hx-get={ "/requests/" + q.Name + "/edit" } hx-target={ "#req-" + q.Name } hx-swap="outerHTML" title="change owner, days, budget, or purpose before approving" data-action="edit">Edit<span class="vh">{ " " + q.Name }</span></button>
			}
			if canWithdraw(pg.Viewer, q) {
				@withdrawForm(q)
			}
		</div>
	}
}

// withdrawForm is Withdraw for one request. It asks before it acts, and its
// button names the request for screen readers.
templ withdrawForm(q core.Request) {
	<form class="inline" hx-post={ "/requests/" + q.Name + "/withdraw" } hx-target="#pending" hx-swap="morph" hx-include="#show-closed" hx-confirm={ "Withdraw the request for " + q.Name + "?" } hx-sync="this:drop" data-action="withdraw">
		@versionField(q)
		<button type="submit">@busyWord("Withdraw", "Withdrawing")<span class="vh">{ " " + q.Name }</span></button>
	</form>
}

// sawVersion names the version that the page showed, for a request that
// changed after it. It is a component, so templ writes no space before
// it.
templ sawVersion(s slipView) {
	if s.changed() {
		{ ", you saw " }<s><code>{ versionLabel(s.Result.Ref.Version) }</code></s>
	}
}

// utcTime writes a time in UTC as people read it, with the exact time
// for machines.
templ utcTime(t time.Time) {
	<time datetime={ t.UTC().Format(time.RFC3339) }>{ t.UTC().Format("Jan 2, 15:04 UTC") }</time>
}

// chevrons are the two marks of a slip name: right while the slip is
// closed, down while it is open. The stylesheet shows the one that
// matches aria-expanded, because only stamps turn.
templ chevrons() {
	<svg class="i slip-closed" aria-hidden="true" focusable="false"><use href="#i-chevron-right"></use></svg><svg class="i slip-opened" aria-hidden="true" focusable="false"><use href="#i-chevron-down"></use></svg>
}

// shownFields carry the values that the slip shows. A post that core
// refuses as changed then names what changed. They decide nothing.
templ shownFields(q core.Request) {
	for _, f := range shownOf(q) {
		<input type="hidden" name={ shownName(f.Field, q.Name) } value={ f.Value }/>
	}
}

// ownRequests is the queue of a viewer who is not an approver: the
// requests that the viewer asked for or owns, on paper. The region and the
// refusal slot sit under the head in every state, so a morph pairs them by
// id. A queue that did not load says so.
templ ownRequests(pg page, oob bool) {
	{{ items, line := pg.left(), ownLine(pg) }}
	<section
		id="pending"
		class="panel"
		if oob {
			hx-swap-oob="morph"
		}
		aria-labelledby="pending-title"
	>
		// app.js moves the focus to the heading when no row waits, so the
		// heading takes focus from script only.
		<div class="panel-head">
			<h2 id="pending-title" tabindex="-1">Your requests</h2>
			if line != "" {
				<p class="panel-line">{ line }</p>
			}
		</div>
		@region()
		<div id="pending-error" class="refusal">
			if len(items) > 0 {
				@leftNote(items)
			}
		</div>
		if pg.PendingFailed {
			@queueFailed()
		} else if len(pg.Pending) == 0 {
			<p class="empty">You have no requests waiting.</p>
		} else {
			<ol class="slips" role="list">
				for _, q := range pg.Pending {
					@ownSlip(pg, q)
				}
			</ol>
		}
	</section>
}

// ownSlip is one row of Your requests. It shows the facts, the time by
// which an approver must decide, and Withdraw. It has no name button and no
// details. The heading takes the focus from script only, so app.js can
// focus the row of a link.
templ ownSlip(pg page, q core.Request) {
	<li id={ "req-" + q.Name } class="slip" data-state="pending">
		<div class="slip-main">
			<div class="slip-top">
				<h3 class="slip-title" tabindex="-1"><span class="slip-name">{ q.Name }</span></h3>
				if q.OverrideLimits {
					<span class="flag" title="an admin allowed values above the ceilings">limits overridden</span>
				}
			</div>
			@slipLines(pg.Viewer, q)
			if pg.Limits.RequestTTL > 0 {
				<p class="slip-meta">{ "An approver must decide by " }@utcTime(q.DropsAt(pg.Limits.RequestTTL)), or playplace drops the request.</p>
			}
		</div>
		@slipFacts(slipView{Req: q})
		<div class="slip-actions">
			if canWithdraw(pg.Viewer, q) {
				<div class="row-actions">@withdrawForm(q)</div>
			}
			<p class="slip-version">{ "version " }<code>{ versionLabel(q.Version()) }</code></p>
		</div>
	</li>
}

// requestSlip is the answer of GET /requests/{name}/row: the slip of an
// approver, or the row of Your requests.
templ requestSlip(pg page, q core.Request) {
	if pg.Viewer.Approver {
		@slip(pg, slipView{Req: q})
	} else {
		@ownSlip(pg, q)
	}
}

// versionField binds a form to the request version this slip shows, so the
// click is refused if the request changed or was replaced since.
templ versionField(q core.Request) {
	<input type="hidden" name="version" value={ q.Version() }/>
}

// breakable renders an identity with a break opportunity after the @, so a
// narrow column splits "name@" / "host" instead of mid-word.
templ breakable(s string) {
	if user, host, ok := strings.Cut(s, "@"); ok {
		{ user + "@" }<wbr/>{ host }
	} else {
		{ s }
	}
}

// slipEdit is the inline edit form. Every field holds the exact stored
// value, and editSave sends only the fields that differ from it. The days
// input takes part of a day, such as 1.5 for 36 hours, and the budget input
// takes cents. The server refuses zero days. Its slip keeps the id of the
// slip it replaces, so Save and Cancel put the slip back in its place.
templ slipEdit(pg page, q core.Request) {
	<li id={ "req-" + q.Name } class="slip slip-edit" data-state="pending">
		<h3 class="slip-title"><span class="slip-name">{ q.Name }</span></h3>
		<form hx-post={ "/requests/" + q.Name + "/edit" } hx-target="#pending" hx-swap="morph" hx-include="#show-closed" hx-sync="this:drop" data-editing data-action="save">
			@versionField(q)
			<div class="form-row">
				<label class="field">owner<input name="owner" value={ q.Owner } size="24"/></label>
				<label class="field">{ dayLabel(q.TTL) }<input name="ttl" type="number" min="0" step="any" value={ dayValue(q.TTL) } class="in-days"/></label>
				<label class="field">budget $<input name="budget" type="number" min="0.01" step="0.01" value={ budgetValue(q.BudgetUSD) } class="in-budget"/></label>
				<label class="field">purpose<input name="purpose" value={ q.Purpose } size="28" maxlength={ fmt.Sprint(core.MaxPurpose) } pattern={ tagPattern } title="letters, numbers, spaces, and _ . : / = + - @"/></label>
				<label class="check" title="allow values above the ceilings"><input type="checkbox" name="override" checked?={ q.OverrideLimits }/>override limits</label>
				<button type="submit" class="btn-primary">@busyWord("Save", "Saving")</button>
				<button type="button" hx-get={ "/requests/" + q.Name + "/row" } hx-target={ "#req-" + q.Name } hx-swap="outerHTML" data-action="cancel">Cancel</button>
			</div>
		</form>
	</li>
}

// accountsPanel is the accounts panel. When the list did not load, errMsg
// holds the text of refusal for the error, the head shows no count and the
// panel says the list is unavailable. An empty list would look like a fleet
// with no accounts. The section keeps polling, so the next good poll fills
// it. oob marks it as an out-of-band part of an htmx answer. hash is the
// poll hash of this answer. pollHash renders the section with no hash, so
// the hash never covers itself.
templ accountsPanel(pg page, rows []accountRow, errMsg, hash string, oob bool) {
	<section
		id="accounts"
		class="panel"
		hx-get={ tableURL(pg.ShowAll) }
		hx-trigger="every 15s"
		hx-swap="morph"
		aria-labelledby="accounts-title"
		if oob {
			hx-swap-oob="morph"
		}
		if hash != "" {
			data-poll-hash={ hash }
		}
	>
		<div class="panel-head">
			<h2 id="accounts-title">
				if pg.SignIn && !pg.Viewer.Admin {
					Your accounts
				} else {
					Accounts
				}
				if errMsg == "" {
					<span class="muted">({ fmt.Sprint(len(rows)) })</span>
				}
			</h2>
			<label class="check" title="include accounts AWS explicitly reports CLOSED"><input id="show-closed" type="checkbox" name="all" value="1" checked?={ pg.ShowAll } hx-get="/accounts" hx-target="#accounts" hx-swap="morph" hx-trigger="change"/>Show closed</label>
		</div>
		// A failed load is one note: the problem, then the refusal text of
		// the error and the recovery. An empty list is one plain line, as in
		// Your requests. Neither has column heads. The head keeps Show
		// closed, and the section keeps polling. The error note has an id, so
		// a morph never pairs it with the table that replaces it.
		if errMsg != "" {
			<div id="accounts-error" class="refusal">@icon("alert")<div class="note-text"><p class="note-title">The account list is unavailable.</p><p class="note-body">{ errMsg + " The page tries again every 15 seconds." }</p></div></div>
		} else if len(rows) == 0 {
			<p class="empty">
				if pg.ShowAll {
					No accounts.
				} else {
					No open accounts.
				}
			</p>
		} else {
			<div class="scroll">
				<table class="fleet">
					<thead>
						<tr><th scope="col">Name</th><th scope="col">Owner</th><th scope="col">Status</th><th scope="col">Account</th><th scope="col">Expires</th><th scope="col">Spend / Budget</th><th scope="col"><span class="vh">Actions</span></th></tr>
					</thead>
					<tbody>
						for _, r := range rows {
							@accountTR(r)
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

// accountTR is one row of the fleet table. A placement wait is settling, not
// a failure, so it is a qualifier with a clock. Errors are red with an alert.
templ accountTR(r accountRow) {
	<tr id={ "acct-" + r.Account.ID }>
		<td><a href={ templ.SafeURL("/accounts/" + r.Account.ID) }>{ r.Account.Name }</a></td>
		<td><span class="owner" title={ r.Account.Owner }>{ r.Account.Owner }</span></td>
		<td>
			@statusLabel(r.Account)
			if r.Account.LastError != "" && r.Account.Status == core.StatusCreating {
				<div class="qualifier">@icon("clock")<span>{ r.Account.LastError }</span></div>
			} else if r.Account.LastError != "" {
				<div class="error">@icon("alert")<span>{ r.Account.LastError }</span></div>
			}
			if r.Account.RepairError() != nil {
				<div class="error">@icon("alert")<span>{ r.Account.RepairError().Error() }</span></div>
			}
		</td>
		<td><code>{ r.Account.ProviderID }</code></td>
		// A pending request counts its expiry from now, so the exact time
		// would change on every read and every poll would get 200, not 204.
		<td
			if r.Account.Status != core.StatusPending {
				title={ expiryDate(r.Account.ExpiresAt, time.RFC3339) }
			}
		>
			if r.Account.Status == core.StatusActive || r.Account.Status == core.StatusExpiring || r.Account.Status == core.StatusClosing {
				{ expiresIn(r.Account.ExpiresAt) }
			} else if !r.Account.ExpiresAt.IsZero() && r.Account.Status != core.StatusFailed && r.Account.Status != core.StatusClosed {
				<span class="muted" title="once created">{ expiresIn(r.Account.ExpiresAt) }</span>
			} else {
				<span class="muted">—</span>
			}
		</td>
		<td>
			<div class="spend">{ fmt.Sprintf("$%.2f / %s", r.Spend, budgetAmount(r.Account.BudgetUSD)) }</div>
			if r.Account.BudgetUSD > 0 {
				@meterLine(spendMeter(r.Spend, r.Account.BudgetUSD, meterWidth), fmt.Sprintf("$%.2f of $%.2f", r.Spend, r.Account.BudgetUSD))
			}
			@budgetLabel(r.Account.BudgetHealth, r.Account.BudgetError)
		</td>
		<td class="actions">
			<div class="row-actions">
				if r.Account.CanExtend() {
					<form class="inline" hx-post={ "/accounts/" + r.Account.ID + "/extend" } hx-target="#accounts" hx-swap="morph" hx-include="#show-closed" hx-sync="this:drop">
						<input type="hidden" name="by" value="7d"/>
						<button type="submit" title="extend by 7 days" class="btn-approve">
							@icon("stamp")
							+7d<span class="vh">{ " " + r.Account.Name }</span>
						</button>
					</form>
				}
				if r.Account.Status.CanClose() {
					<form class="inline" hx-post={ "/accounts/" + r.Account.ID + "/close" } hx-target="#accounts" hx-swap="morph" hx-include="#show-closed" hx-confirm={ "Request closure of " + r.Account.Name + "? AWS processes closure asynchronously. Charges may continue while pending, and commitments or subscriptions can outlive closure." } hx-sync="this:drop" data-action="close">
						<button type="submit">Close<span class="vh">{ " " + r.Account.Name }</span></button>
					</form>
				}
			</div>
		</td>
	</tr>
}

// statusLabel is the icon and the word of an account status. An overdue
// closure (core ClosureOverdue) turns its box red, and the qualifier
// "overdue" follows the word, because color alone never names a state.
templ statusLabel(a *core.Account) {
	<span class={ "status", "status-" + string(a.Status), templ.KV("status-overdue", a.ClosureOverdue()) }>@icon(statusIcon(a.Status))<span>{ string(a.Status) }</span></span>
	if a.ClosureOverdue() {
		<span class="qualifier">overdue</span>
	}
}

// budgetLabel is the icon and the word of a budget protection state. The
// error text, if any, is the tooltip. A settling state adds a qualifier.
templ budgetLabel(health, errText string) {
	{{ look, word := budgetState(health) }}
	<span
		class={ "status", "budget-" + look.Tone }
		if errText != "" {
			title={ storedFailure(errText) }
		}
	>@icon(look.Icon)<span>{ word }</span></span>
	if look.Settling {
		<span class="qualifier">settling protection</span>
	}
}

// meterLine draws the spend meter as SVG. The fill length is a width
// attribute and the colors come from classes, because the CSP allows no
// inline style. The label sits to the right, so the row stays one line.
templ meterLine(m meter, title string) {
	<div class={ "meter-line", "meter-" + m.Level } title={ title }>
		<svg class="meter" width={ strconv.Itoa(meterWidth) } height="4" viewBox={ "0 0 " + strconv.Itoa(meterWidth) + " 4" } aria-hidden="true" focusable="false"><rect class="meter-track" width={ strconv.Itoa(meterWidth) } height="4" rx="2"></rect><rect class="meter-fill" width={ strconv.Itoa(m.Fill) } height="4" rx="2"></rect></svg>
		if m.Label != "" {
			<span class="meter-label">
				if m.Level == "near" || m.Level == "over" {
					@icon("alert")
				}
				{ m.Label }
			</span>
		}
	</div>
}

templ accountPage(pg page, a *core.Account, costs []core.CostPoint, total float64, history historyView) {
	@layout(pg, a.Name) {
		<section class="panel" aria-labelledby="account-title">
			<div class="panel-head">
				<h1 id="account-title">{ a.Name }</h1>
				// One wrapper keeps the label and its qualifier together, so
				// they wrap as one unit beside or below the name.
				<span class="head-status">@statusLabel(a)</span>
			</div>
			<div class="panel-body">
				<dl class="facts">
					<dt>owner</dt><dd>{ a.Owner }</dd>
					<dt>account id</dt>
					<dd>
						if a.ProviderID == "" {
							<span class="muted">{ notCreated(a) }</span>
						} else {
							<code>{ a.ProviderID }</code>
						}
					</dd>
					if a.RequestID != "" {
						// Courier Prime is only for account IDs and request versions,
						// so the creation request id is plain text.
						<dt>request id</dt><dd>{ a.RequestID }</dd>
					}
					<dt>root email</dt>
					<dd>
						if a.Email == "" {
							<span class="muted">{ notCreated(a) }</span>
						} else {
							{ a.Email }
						}
					</dd>
					<dt>budget</dt><dd>{ budgetAmount(a.BudgetUSD) } / month</dd>
					<dt>budget protection</dt>
					<dd>
						@budgetLabel(a.BudgetHealth, a.BudgetError)
						if a.BudgetChecked != "" {
							<span class="muted">(in this state since { observedAt(a.BudgetChecked) })</span>
						}
					</dd>
					if a.BudgetError != "" {
						<dt>budget error</dt><dd class="error">@icon("alert")<span>{ storedFailure(a.BudgetError) }</span></dd>
					}
					<dt>spend, 30 days</dt><dd>{ fmt.Sprintf("$%.2f", total) }</dd>
					// Every time on this page is in UTC, the same as the history
					// table. A stored time keeps the zone it was read in.
					<dt>created</dt><dd>{ a.CreatedAt.UTC().Format("2006-01-02 15:04 MST") }</dd>
					if a.ProviderID != "" {
						<dt>expires</dt><dd>{ expiryDate(a.ExpiresAt, "2006-01-02 15:04 MST") }
							if !a.ExpiresAt.IsZero() {
								<span class="muted">({ expiresIn(a.ExpiresAt) })</span>
							}
						</dd>
					}
					if a.WarnedAt != nil {
						<dt>expiring notice sent</dt><dd>{ a.WarnedAt.UTC().Format("2006-01-02 15:04 MST") }</dd>
					}
					if a.CloseRequestedAt != nil {
						<dt>close requested</dt><dd>{ a.CloseRequestedAt.UTC().Format("2006-01-02 15:04 MST") }</dd>
					}
					if a.LastError != "" && a.Status == core.StatusCreating {
						// A creation that waits in the root for placement: a qualifier, not a failure.
						<dt>placement</dt><dd class="qualifier">@icon("clock")<span>{ a.LastError }</span></dd>
					} else if a.LastError != "" {
						<dt>failure</dt><dd class="error">@icon("alert")<span>{ a.LastError }</span></dd>
					}
					if a.RepairError() != nil {
						<dt>repair required</dt><dd class="error">@icon("alert")<span>{ a.RepairError().Error() }</span></dd>
					}
					if !a.Managed {
						<dt>note</dt><dd class="muted">not yet tagged by playplace; the next sync adopts it</dd>
					}
				</dl>
			</div>
		</section>
		if pg.Viewer.Admin && a.Managed && a.Status.CanExtend() && a.RepairError() == nil {
			<section class="panel" aria-labelledby="budget-title">
				<div class="panel-head"><h2 id="budget-title">Change monthly budget</h2></div>
				<div class="panel-body">
					<p class="lede">An increase above reported spend can lift the provisioning restriction and rearm enforcement. AWS billing and policy changes are delayed. Existing resources keep charging.</p>
					<form hx-post={ "/accounts/" + a.ID + "/budget" } hx-sync="this:drop">
						<div class="form-row">
							<label class="field">USD per month<input name="budget" type="number" min="0.01" step="0.01" value={ fmt.Sprintf("%.2f", a.BudgetUSD) } required class="in-budget"/></label>
							<label class="field">reason<input name="reason" maxlength="500" required/></label>
							<label class="check"><input type="checkbox" name="override"/>override budget ceiling</label>
							<button type="submit" class="btn-primary">@busyWord("Save budget", "Saving")</button>
						</div>
					</form>
					<div id="form-error" class="refusal"></div>
				</div>
			</section>
		}
		if history.Enabled {
			<section class="panel" aria-labelledby="history-title">
				<div class="panel-head">
					<h2 id="history-title">History</h2>
					if history.OrderURL != "" {
						<a class="link" href={ templ.SafeURL(history.OrderURL) }>
							if history.OldestFirst {
								Show newest first
							} else {
								Show oldest first
							}
						</a>
					}
				</div>
				if history.Notice != "" {
					<p class="empty">{ history.Notice }</p>
				}
				if history.Error != "" {
					<div class="panel-body"><p class="error page-error">@icon("alert")<span>{ history.Error }</span></p></div>
				} else if len(history.Page.Events) == 0 && !history.Page.Incomplete {
					<p class="empty">Nothing recorded yet for this journey.</p>
				} else if len(history.Page.Events) > 0 {
					<div class="scroll">
						<table class="history">
							<thead><tr><th scope="col">When</th><th scope="col">Event</th><th scope="col">By</th><th scope="col">What happened</th></tr></thead>
							<tbody>
								for _, e := range history.Page.Events {
									<tr>
										<td title={ e.At.UTC().Format(time.RFC3339Nano) }>{ e.At.UTC().Format("2006-01-02 15:04:05 MST") }</td>
										<td><span class="event">{ e.Event }</span></td>
										<td>{ e.Actor }
											if e.Via != "" {
												<span class="muted">via { e.Via }</span>
											}
										</td>
										<td class="wrap">{ e.Message }
											if len(e.Details) > 0 {
												<details><summary>Details</summary><pre>{ historyDetails(e) }</pre></details>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>
		}
		if history.Enabled && history.Page.Incomplete {
			<p class="banner-incomplete">@icon("alert")<span>History is incomplete: some stored records could not be read.</span></p>
		}
		if history.NextURL != "" {
			<p><a class="link" href={ templ.SafeURL(history.NextURL) }>Next history page</a></p>
		}
		<section class="panel panel-fit" aria-labelledby="spend-title">
			<div class="panel-head"><h2 id="spend-title">Daily spend</h2></div>
			if len(costs) == 0 {
				<p class="empty">No cost data yet.</p>
			} else {
				<div class="scroll">
					<table class="daily">
						<thead><tr><th scope="col">Date</th><th scope="col" class="num">USD</th></tr></thead>
						<tbody>
							for i := len(costs) - 1; i >= 0; i-- {
								<tr><td>{ costs[i].Date.Format("2006-01-02") }</td><td class="num">{ fmt.Sprintf("%.2f", costs[i].AmountUSD) }</td></tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}

// errorPage is a styled 400, 403 or 404 page: the title and the status
// code, a refusal note that names the problem and the recovery, and one way
// back. The note stacks its two lines, so the message stays the semibold
// first line and the recovery is the body.
templ errorPage(pg page, e errorView) {
	@layout(pg, e.Title) {
		<section class="panel" aria-labelledby="error-title">
			<div class="panel-head"><h1 id="error-title">{ e.Title }</h1><span class="muted">{ fmt.Sprint(e.Code) }</span></div>
			<div class="panel-body">
				<div class="refusal">@icon("alert")<div class="note-text"><p class="note-title">{ e.Message }</p><p class="note-body">{ e.Recovery }</p></div></div>
				<p class="way-back"><a class="btn btn-primary" href={ templ.SafeURL(e.Back) }>{ e.BackLabel }</a></p>
			</div>
		</section>
	}
}

// noticeFragment writes a message into the live region. htmx swaps only what
// is inside, so the region node keeps its role. Sync says what it found with
// its own icon. The result of an action gets the check in shelf ink, the
// color of the healthy state.
templ noticeFragment(iconName, msg string) {
	<p id="notice" hx-swap-oob="innerHTML"><svg class={ "i", templ.KV("i-ok", iconName == "check") } aria-hidden="true" focusable="false"><use href={ "#i-" + iconName }></use></svg><span>{ msg }</span></p>
}

// errorFragment fills the refusal slot with this id: form-error under a form,
// or pending-error in the queue panel. It names what went wrong beside the
// thing it is about, with an alert icon. The live region gets the same text
// as a hidden copy, so a screen reader hears it once and nobody sees it
// twice.
templ errorFragment(id, msg string) {
	<div id={ id } hx-swap-oob="innerHTML">@icon("alert")<span>{ msg }</span></div>
	@hiddenNotice(msg)
}

// hiddenNotice writes msg into the live region as a hidden copy. The
// text that people see sits beside the thing it is about.
templ hiddenNotice(msg string) {
	<p id="notice" hx-swap-oob="innerHTML"><span class="vh">{ msg }</span></p>
}
